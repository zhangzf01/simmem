diff --git a/slime/backends/megatron_utils/data.py b/slime/backends/megatron_utils/data.py
index 405ff89d..7942748f 100644
--- a/slime/backends/megatron_utils/data.py
+++ b/slime/backends/megatron_utils/data.py
@@ -297,14 +297,47 @@ def _get_capped_partitions(seqlen_list: Sequence[int], num_partitions: int, max_
     partitions: list[list[int]] = [[] for _ in range(num_partitions)]
     sums = [0] * num_partitions
 
-    for idx, length in enumerate(seqlen_list):
+    # Longest sequences first (first-fit-decreasing) packs tighter than first-fit in input order.
+    # The number of micro-batches must not change locally: it is fixed by a DP all-reduce (MAX) and
+    # must agree across ranks, otherwise ranks run different numbers of forward/backward passes and hang.
+    order = sorted(range(len(seqlen_list)), key=lambda i: seqlen_list[i], reverse=True)
+
+    for idx in order:
+        length = seqlen_list[idx]
         for i in range(num_partitions):
             if sums[i] + length <= max_tokens:
                 partitions[i].append(idx)
                 sums[i] += length
                 break
         else:
-            raise AssertionError("This should never happen.")
+            # A single sample longer than the cap cannot be packed at all; the configuration must change.
+            raise AssertionError(
+                f"sample {idx} has length {length} > per-micro-batch token cap {max_tokens} "
+                f"(= --max-tokens-per-gpu * context-parallel-size); "
+                f"longest sample in this step = {max(seqlen_list)}, num_microbatches = {num_partitions}. "
+                f"Raise --max-tokens-per-gpu or increase context-parallel-size so the cap exceeds the "
+                f"longest sample, otherwise this step cannot be scheduled."
+            )
+
+    # FFD fills the first bins and may leave the last ones empty; an empty micro-batch makes
+    # torch.cat([]) in get_batch() raise, so move samples over until every bin holds at least one.
+    # Every sample is <= max_tokens (guaranteed by the FFD pass above), so the move is always valid.
+    for i in range(num_partitions):
+        if partitions[i]:
+            continue
+        src = max(range(num_partitions), key=lambda j: len(partitions[j]))
+        if len(partitions[src]) <= 1:
+            break
+        idx = partitions[src].pop()
+        sums[src] -= seqlen_list[idx]
+        partitions[i].append(idx)
+        sums[i] += seqlen_list[idx]
+
+    if any(not p for p in partitions):
+        raise AssertionError(
+            f"Cannot fill all {num_partitions} micro-batches: only {len(seqlen_list)} samples. "
+            f"num_microbatches must not exceed the number of samples."
+        )
 
     return [sorted(p) for p in partitions]
 
